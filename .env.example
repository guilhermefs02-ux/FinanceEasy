# Copie este arquivo para ".env" e preencha os valores.
# Nunca faça commit do arquivo .env real no Git.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CSRF e compartilhamento por túnel ---
# Informe as origens confiáveis quando necessário.
DJANGO_CSRF_TRUSTED_ORIGINS=
TUNNEL_BASIC_AUTH_USER=
TUNNEL_BASIC_AUTH_PASS=

# --- Banco de dados ---
# Opcional: caminho para SQLite local.
DJANGO_DB_PATH=

# --- HG Brasil Finance API ---
# Opcional: chave da API para dados financeiros do painel.
HGBRASIL_API_KEY=
HGBRASIL_CACHE_TTL_SECONDS=900

# --- Groq API ---
# Gere sua chave em https://console.groq.com/keys
# No Render, configure GROQ_API_KEY nas Environment Variables.
# Não compartilhe nem faça commit da chave.
GROQ_API_KEY=

# Modelo de classificação utilizado pela Groq.
GROQ_MODEL=openai/gpt-oss-20b

# Tempo limite das chamadas à API, em segundos.
GROQ_TIMEOUT_SECONDS=8
