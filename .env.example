# Copie este arquivo para ".env" e preencha os valores.
# O .env nunca deve ser commitado no Git (já está no .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Preencha com a URL do tunel (ngrok/Cloudflare) quando for compartilhar
# o app com o time para teste, ex.: https://meu-tunel.trycloudflare.com
# Sem isso, login/cadastro (POST) vao falhar com erro 403 CSRF quando
# acessados por um dominio diferente de localhost.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Caminho opcional para o arquivo do banco SQLite. Deixe em branco para usar
# o padrao (db.sqlite3 ao lado do manage.py). So e necessario preencher se a
# pasta do projeto estiver numa unidade de rede/sincronizada onde o SQLite
# nao suporta locks de arquivo corretamente (erro "disk I/O error").
DJANGO_DB_PATH=

# --- Compartilhamento temporario via tunel (ngrok/Cloudflare Tunnel) ---
# Preencha so quando for expor o app pela internet para o time testar.
# Veja o passo a passo que o Claude te enviou no chat.
DJANGO_CSRF_TRUSTED_ORIGINS=
TUNNEL_BASIC_AUTH_USER=
TUNNEL_BASIC_AUTH_PASS=

# --- HG Brasil Finance API (https://hgbrasil.com/finance/) ---
# Plano gratuito: 400 requisições/dia. Crie sua conta em hgbrasil.com,
# gere sua chave e cole aqui. Sem chave, o painel mostra um aviso e
# segue funcionando normalmente (sem os dados de mercado).
HGBRASIL_API_KEY=
HGBRASIL_CACHE_TTL_SECONDS=900

# --- Hugging Face Inference API (https://huggingface.co) ---
# Crie uma conta gratuita, gere um token em huggingface.co/settings/tokens
# (permissão de leitura já é suficiente) e cole aqui. Usado para sugerir
# a categoria de despesas importadas do extrato quando nenhuma regra por
# palavra-chave reconhece a descrição. Sem token, o sistema usa apenas as
# regras + "Outros" como categoria padrão (você reclassifica na tela de
# conciliação).
HUGGINGFACE_API_TOKEN=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
HUGGINGFACE_ZERO_SHOT_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
